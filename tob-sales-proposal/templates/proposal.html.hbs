<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{client}} - {{product}}解决方案提案</title>
  <style>
    :root {
      --brand: #2563eb;
      --brand-dark: #1e3a8a;
      --brand-soft: #dbeafe;
      --accent: #f97316;
      --ink: #111827;
      --muted: #6b7280;
      --line: #e5e7eb;
      --bg: #f8fafc;
      --card: #ffffff;
      --success: #16a34a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: linear-gradient(135deg, #eff6ff 0%, #f8fafc 42%, #fff7ed 100%);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
      line-height: 1.65;
    }
    .deck { max-width: 1120px; margin: 0 auto; padding: 32px 20px 88px; }
    .hero {
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      padding: 44px;
      color: #fff;
      background: radial-gradient(circle at 86% 18%, rgba(249,115,22,.85), transparent 26%), linear-gradient(135deg, var(--brand-dark), var(--brand));
      box-shadow: 0 24px 70px rgba(30, 58, 138, .24);
    }
    .hero::after { content: ""; position: absolute; inset: auto -80px -120px auto; width: 360px; height: 360px; border-radius: 50%; background: rgba(255,255,255,.12); }
    .eyebrow { margin: 0 0 12px; letter-spacing: .18em; text-transform: uppercase; opacity: .82; font-size: 13px; }
    h1 { margin: 0; font-size: clamp(30px, 5vw, 56px); line-height: 1.08; }
    .subtitle { max-width: 720px; margin: 18px 0 0; font-size: 18px; opacity: .92; }
    .meta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
    .pill { padding: 8px 13px; border-radius: 999px; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(8px); }
    .nav {
      position: sticky; top: 0; z-index: 10;
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;
      margin: 22px 0; padding: 12px; border-radius: 20px;
      background: rgba(255,255,255,.86); backdrop-filter: blur(14px); box-shadow: 0 12px 35px rgba(15,23,42,.08);
    }
    .nav a { text-decoration: none; color: var(--brand-dark); font-weight: 700; text-align: center; padding: 12px; border-radius: 14px; }
    .nav a:hover { background: var(--brand-soft); }
    .page {
      min-height: 720px;
      margin: 22px 0;
      padding: 36px;
      border-radius: 26px;
      background: var(--card);
      box-shadow: 0 16px 48px rgba(15,23,42,.08);
      page-break-after: always;
    }
    .page:last-of-type { page-break-after: auto; }
    .page-head { display: flex; justify-content: space-between; gap: 18px; align-items: flex-start; border-bottom: 1px solid var(--line); padding-bottom: 18px; margin-bottom: 26px; }
    .page-no { color: var(--accent); font-weight: 900; font-size: 14px; letter-spacing: .14em; }
    h2 { margin: 4px 0 0; font-size: 32px; color: var(--brand-dark); }
    h3 { margin: 26px 0 10px; font-size: 20px; color: #0f172a; }
    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .grid.two { grid-template-columns: repeat(2, 1fr); }
    .card { padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: linear-gradient(180deg, #fff, #f8fafc); }
    .card strong { color: var(--brand-dark); }
    ul { padding-left: 20px; margin: 8px 0 0; }
    li { margin: 7px 0; }
    table { width: 100%; border-collapse: collapse; margin-top: 14px; overflow: hidden; border-radius: 16px; }
    th, td { padding: 13px 14px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
    th { background: var(--brand-soft); color: var(--brand-dark); }
    .timeline { display: grid; gap: 14px; }
    .phase { border-left: 5px solid var(--brand); padding: 16px 18px; border-radius: 14px; background: #f8fafc; }
    .case { border: 1px solid var(--line); border-radius: 18px; padding: 18px; margin-top: 14px; }
    .roi { display: grid; grid-template-columns: 1fr 2fr; gap: 18px; align-items: stretch; }
    .metric { display: grid; place-items: center; text-align: center; border-radius: 22px; background: linear-gradient(135deg, var(--brand), var(--success)); color: #fff; padding: 24px; }
    .metric b { display: block; font-size: 38px; line-height: 1; }
    .footer-tip {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
      padding: 14px 20px;
      background: rgba(17,24,39,.94); color: #fff; text-align: center; font-weight: 700;
      box-shadow: 0 -10px 30px rgba(15,23,42,.18);
    }
    .footer-tip span { color: #fed7aa; }
    @media (max-width: 820px) { .hero, .page { padding: 24px; } .nav, .grid, .grid.two, .roi { grid-template-columns: 1fr; } .nav { position: static; } }
    @media print { body { background: #fff; } .deck { padding: 0; max-width: none; } .nav, .footer-tip { display: none; } .hero, .page { box-shadow: none; border-radius: 0; } }
  </style>
</head>
<body>
  <main class="deck">
    <section class="hero">
      <p class="eyebrow">ToB Sales Proposal</p>
      <h1>{{client}}<br>{{product}}解决方案</h1>
      <p class="subtitle">基于{{industry}}行业洞察、客户痛点、案例经验与ROI模型生成的四模块提案页面。</p>
      <div class="meta">
        <span class="pill">提案日期：{{generatedAt}}</span>
        <span class="pill">预算范围：{{budget}}</span>
        <span class="pill">交付周期：{{timeline}}</span>
        <span class="pill">输出格式：HTML</span>
      </div>
    </section>

    <nav class="nav" aria-label="提案分页导航">
      <a href="#page-1">01 痛点对齐</a>
      <a href="#page-2">02 方案对齐</a>
      <a href="#page-3">03 实施路径</a>
      <a href="#page-4">04 ROI与案例</a>
    </nav>

    <section class="page" id="page-1">
      <div class="page-head"><div><div class="page-no">PAGE 01 / 04</div><h2>痛点对齐：让客户觉得你懂他</h2></div></div>
      <div class="grid two">
        <div class="card"><strong>客户输入摘要</strong><ul><li>客户：{{client}}</li><li>行业：{{industry}}</li><li>目标方案：{{product}}</li>{{#if painpoints}}<li>明确痛点：{{painpoints}}</li>{{/if}}</ul></div>
        <div class="card"><strong>行业趋势</strong><ul>{{#each industryInsight.trends}}<li>{{this}}</li>{{/each}}</ul></div>
      </div>
      <h3>行业共性挑战</h3>
      <div class="grid">{{#each industryInsight.challenges}}<div class="card"><strong>{{this}}</strong><br>影响业务效率、成本控制与竞争力，需要用可落地的数字化能力逐步拆解。</div>{{/each}}</div>
      {{#if painpoints}}<h3>客户特定痛点翻译</h3><ul>{{#each (split painpoints ',')}}<li><strong>{{this}}</strong> → 转化为可定义、可度量、可验收的业务改进目标。</li>{{/each}}</ul>{{/if}}
      <h3>数字化机会</h3><ul>{{#each industryInsight.opportunities}}<li>{{this}}</li>{{/each}}</ul>
    </section>

    <section class="page" id="page-2">
      <div class="page-head"><div><div class="page-no">PAGE 02 / 04</div><h2>方案对齐：为什么要选这个方案</h2></div></div>
      <div class="card"><strong>方案核心</strong><h3>{{solution.core}}</h3><p>本方案专为{{client}}设计，结合{{industry}}行业最佳实践，优先解决高频、关键、能快速看到业务价值的问题。</p></div>
      <h3>核心功能与客户价值</h3>
      <div class="grid">{{#each solution.features}}<div class="card"><strong>{{this}}</strong><br>围绕痛点场景提供可配置、可集成、可持续优化的能力。</div>{{/each}}</div>
      <h3>方案价值</h3><p class="card">{{solution.value}}</p>
      <table><thead><tr><th>能力维度</th><th>具体说明</th><th>客户价值</th></tr></thead><tbody><tr><td>行业咨询</td><td>结合{{industry}}行业经验做痛点拆解</td><td>减少试错</td></tr><tr><td>方案设计</td><td>从业务场景到系统能力映射</td><td>避免功能堆砌</td></tr><tr><td>系统集成</td><td>对接现有数据、流程与权限体系</td><td>保障落地</td></tr><tr><td>持续运维</td><td>上线后监控、复盘与优化</td><td>持续产生价值</td></tr></tbody></table>
    </section>

    <section class="page" id="page-3">
      <div class="page-head"><div><div class="page-no">PAGE 03 / 04</div><h2>实施路径：消除落地恐惧</h2></div></div>
      <div class="timeline">{{#each implementation.phases}}<div class="phase"><h3>{{name}}</h3><p><strong>时间安排：</strong>{{duration}}</p><ul>{{#each tasks}}<li>{{this}}</li>{{/each}}</ul></div>{{/each}}</div>
      <h3>里程碑节点</h3>
      <table><thead><tr><th>里程碑</th><th>交付物</th><th>验收标准</th></tr></thead><tbody><tr><td>需求确认</td><td>需求规格说明书</td><td>双方签字确认</td></tr><tr><td>设计完成</td><td>系统设计方案</td><td>评审通过</td></tr><tr><td>开发完成</td><td>测试版本系统</td><td>功能测试通过</td></tr><tr><td>上线交付</td><td>生产环境系统</td><td>验收测试通过</td></tr></tbody></table>
      <h3>客户配合清单</h3><ul><li>提供业务流程、数据样例与现有系统接口说明</li><li>指定业务负责人、IT负责人、验收负责人</li><li>每周固定评审，减少返工和范围漂移</li></ul>
    </section>

    <section class="page" id="page-4">
      <div class="page-head"><div><div class="page-no">PAGE 04 / 04</div><h2>承诺型 ROI 与成功案例</h2></div></div>
      <div class="roi"><div class="metric"><span>三年 ROI</span><b>{{roi.threeYearROI}}</b><span>回收期 {{roi.paybackPeriod}}</span></div><div class="card"><strong>投资概算</strong><h3>{{roi.investment}}</h3><p>ROI 采用保守测算口径，优先呈现客户容易验证的收益项。</p><table><thead><tr><th>收益项</th><th>年收益</th><th>说明</th></tr></thead><tbody>{{#each roi.benefits}}<tr><td>{{item}}</td><td>{{value}}</td><td>{{desc}}</td></tr>{{/each}}</tbody></table></div></div>
      <h3>匹配案例</h3>
      {{#each cases}}<div class="case"><strong>{{name}}</strong><p>客户：{{client}} ｜ 行业：{{industry}} ｜ 解决方案：{{#each solutions}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{#if keyResults}}<p><strong>关键成果：</strong>{{keyResults}}</p>{{/if}}{{#if key_learnings}}<ul>{{#each key_learnings}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</div>{{/each}}
      <h3>商务建议</h3><table><thead><tr><th>项目</th><th>建议</th></tr></thead><tbody><tr><td>付款条款</td><td>合同签订30% / 需求确认30% / 上线验收30% / 质保期满10%</td></tr><tr><td>质保承诺</td><td>12个月质保，2小时内响应，24小时内解决关键问题</td></tr></tbody></table>
    </section>
  </main>
  <div class="footer-tip">提示：可复制本页面内容给 AI，生成 <span>PPT / Keynote / 路演稿</span>。</div>
</body>
</html>
